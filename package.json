{
  "name": "seerat-backend",
  "version": "1.0.0",
  "description": "Production REST API Backend for SEERAT Islamic Social & Reels Platform and Admin Panel",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "dev": "ts-node src/server.ts",
    "migrate": "node dist/database/migrate.js",
    "seed": "node dist/database/seed.js",
    "db:start": "ts-node database/startDb.ts",
    "test:e2e": "ts-node test/e2e.test.ts",
    "test:mobile": "ts-node test/mobile.test.ts",
    "test:persistence": "ts-node test/persistence.test.ts",
    "test:photo": "ts-node test/photo_upload.test.ts",
    "test:moderation": "ts-node test/moderation_ai.test.ts",
    "test": "ts-node test/e2e.test.ts && ts-node test/mobile.test.ts && ts-node test/persistence.test.ts"
  },
  "keywords": [
    "seerat",
    "islamic",
    "admin-panel",
    "postgresql",
    "typescript",
    "express"
  ],
  "author": "SEERAT Engineering Team",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "pg": "^8.12.0",
    "typescript": "^5.5.2",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
