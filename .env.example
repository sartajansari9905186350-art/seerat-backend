# ====================================================================
# SEERAT Backend Environment Variables (.env.example)
# ====================================================================
# IMPORTANT: Provide real production values in Render / deployment environment.
# DO NOT commit real secrets or passwords to Git.

# Server Port (Render sets this dynamically via $PORT)
PORT=5000

# Environment mode ('production' or 'development')
NODE_ENV=production

# CORS allowed origins (Use '*' or comma-separated URLs, e.g. 'https://admin.seerat.app,https://seerat.app')
CORS_ORIGIN=*

# PostgreSQL Database Connection URL (Supabase / Render PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require

# JWT Authentication Secret (Generate a strong 64-character random string)
JWT_SECRET=your-secure-production-jwt-secret-min-32-characters

# JWT Expiry Settings
JWT_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d

# Media Storage Provider ('LOCAL', 'S3', or 'CDN')
STORAGE_PROVIDER=LOCAL
CDN_BASE_URL=https://cdn.seerat.app
MAX_FILE_SIZE_MB=50

# Initial Super Admin Seed Password (Optional, used by seed script)
ADMIN_INITIAL_PASSWORD=your-initial-admin-password
